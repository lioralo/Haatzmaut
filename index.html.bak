<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1e293b" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none';" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <title>מערכת ניהול מרפאה</title>
  <link rel="stylesheet" href="styles.css?v=20260701" />
  <link rel="stylesheet" href="styles.css?v=20260701" />
<body>

  <!-- Toast notification -->
  <div id="toast" class="toast" aria-live="assertive" role="status"></div>

  <!-- Notification bell -->
  <button id="notificationBell" class="notification-bell hidden" aria-label="התראות">
    <span class="bell-icon">🔔</span>
    <span id="notificationBadge" class="bell-badge">0</span>
  </button>

  <!-- Notification dropdown -->
  <div id="notificationPanel" class="notification-panel hidden">
    <div class="notif-header"><h4>התראות</h4><button class="notif-clear">נקה</button></div>
    <div id="notificationList" class="notif-list"></div>
  </div>

  <!-- Booking modal -->
  <dialog id="bookingModal" class="booking-dialog">
    <form id="bookingForm" novalidate>
      <input type="hidden" id="bookingEntryId" />
      <input type="hidden" id="bookingDay" />
      <datalist id="bookingStaffList"></datalist>

      <div class="dialog-head">
        <h3 id="bookingModalTitle">הוספת הזמנה</h3>
        <button type="button" id="bookingClose" class="dialog-close-btn" aria-label="סגור">✕</button>
      </div>

      <div class="dialog-body">
        <div class="dialog-grid">
          <label>מטופל/ת <input id="bookingClientName" placeholder="שם המטופל/ת" /></label>
          <label>טלפון <input id="bookingClientPhone" type="tel" placeholder="050-0000000" /></label>
          <label>חדר <select id="bookingRoomSel" required></select></label>
          <label>שעת התחלה <select id="bookingStart" required></select></label>
          <label>שעת סיום <select id="bookingEnd" required></select></label>
          <label>צוות <select id="bookingTeam" required></select></label>
          <label class="d-full">איש/ת צוות <input id="bookingStaff" list="bookingStaffList" autocomplete="off" required /></label>
          <label>סוג פגישה
            <select id="bookingNoteType">
              <option value="therapy">טיפול</option>
              <option value="intake">אינטייק</option>
              <option value="diagnosis">אבחון</option>
              <option value="discharge">סיום טיפול</option>
              <option value="other">אחר</option>
            </select>
          </label>
          <label class="d-full">הערות <textarea id="bookingNote" rows="2"></textarea></label>
          <label class="d-full checkbox-label">
            <input id="bookingOneTime" type="checkbox" />
            <span>משבצת חד-פעמית</span>
          </label>
        </div>
      </div>

      <div class="dialog-footer">
        <button id="bookingSubmit" type="submit">שמירה</button>
        <button id="bookingSuggestChange" type="button" class="secondary hidden">בקשת שינוי</button>
        <button id="bookingClose2" type="button" class="secondary">ביטול</button>
        <button id="bookingDelete" type="button" class="danger hidden">מחיקה</button>
      </div>
    </form>
  </dialog>

  <!-- Header -->
  <header class="site-header">
    <div class="brand-block">
      <p class="eyebrow">מערכת ניהול מרפאה פנימית</p>
      <h1>מרפאה</h1>
    </div>
    <div id="sessionBar" class="session-bar hidden">
      <div class="session-text">
        <span id="activeUser"></span>
        <span id="activeRole" class="session-role"></span>
      </div>
      <button id="logoutBtn" type="button" class="secondary">התנתקות</button>
    </div>
  </header>

  <!-- Login -->
  <section id="loginSection" class="card auth-card">
    <h2>כניסה מאובטחת</h2>
    <p class="muted">הזינו את פרטי ההתחברות כדי להיכנס למערכת.</p>
    <a class="display-entry-link" href="display.html?v=20260701" target="_blank" rel="noopener">תצוגת קליניקה חיה (למסך המתנה)</a>
    <form id="loginForm" class="auth-form">
      <label>שם משתמש <input id="username" autocomplete="username" required /></label>
      <label>סיסמה <input id="password" type="password" autocomplete="current-password" required /></label>
      <button type="submit">כניסה</button>
    </form>
    <p id="loginError" class="error hidden"></p>
    <div class="demo-creds" id="demoCreds">
      <span>admin / admin123</span>
      <span>staff / staff123</span>
    </div>
    <div style="margin-top:.6rem">
      <button type="button" id="requestResetBtn" class="secondary">שכחתי סיסמה / בקשת איפוס</button>
    </div>
    <div id="resetRequestForm" class="hidden" style="margin-top:.7rem">
      <label>שם משתמש לאיפוס <input id="resetUsername" autocomplete="off" /></label>
      <button type="button" id="submitResetRequest">שלח בקשת איפוס</button>
    </div>
  </section>

  <!-- App shell -->
  <section id="appSection" class="hidden">
    <div class="app-layout">

      <!-- Sidebar -->
      <aside id="sidebar" class="sidebar">
        <button id="sidebarToggle" class="sidebar-toggle" title="צמצם/הרחב תפריט">◀</button>
        <nav class="sidebar-nav">
          <button data-tab="dashboardTab" class="sidebar-item active">
            <span class="sidebar-icon">▦</span>
            <span class="sidebar-label">לוח הזמנות</span>
          </button>
          <button data-tab="requestsTab" class="sidebar-item">
            <span class="sidebar-icon">☰</span>
            <span class="sidebar-label">בקשות</span>
            <span id="requestsBadge" class="sidebar-badge hidden">0</span>
          </button>
          <button data-tab="staffTab" class="sidebar-item admin-only hidden">
            <span class="sidebar-icon">◈</span>
            <span class="sidebar-label">צוות ומשתמשים</span>
          </button>
          <button data-tab="meetingsTab" class="sidebar-item">
            <span class="sidebar-icon">◉</span>
            <span class="sidebar-label">ישיבות צוות</span>
          </button>
          <button data-tab="resourcesTab" class="sidebar-item">
            <span class="sidebar-icon">⊞</span>
            <span class="sidebar-label">מרכז משאבים</span>
          </button>
          <button data-tab="issuesTab" class="sidebar-item">
            <span class="sidebar-icon">⚡</span>
            <span class="sidebar-label">תקלות</span>
            <span id="issuesBadge" class="sidebar-badge hidden">0</span>
          </button>
          <div class="sidebar-divider"></div>
          <button data-tab="adminTab" class="sidebar-item admin-only hidden">
            <span class="sidebar-icon">⛭</span>
            <span class="sidebar-label">ניהול מערכת</span>
          </button>
        </nav>
        <div class="sidebar-footer">
          <a href="display.html?v=20260701" target="_blank" rel="noopener" class="sidebar-item">
            <span class="sidebar-icon">▣</span>
            <span class="sidebar-label">מסך תצוגה</span>
          </a>
        </div>
      </aside>

      <!-- Main content -->
      <main class="main-content">

        <!-- ======== DASHBOARD TAB (calendar) ======== -->
        <section id="dashboardTab" class="card tab-content">
          <!-- Dashboard summary cards -->
          <div id="dashboardSummary" class="dashboard-summary"></div>

          <!-- Room status strip -->
          <div id="roomStatusStrip" class="room-status-strip"></div>

          <!-- Week header + nav -->
          <div class="section-head">
            <div>
              <h2>לוח הזמנות</h2>
              <p id="weekLabel" class="muted"></p>
            </div>
            <div class="week-nav">
              <button id="weekPrev" type="button" class="secondary icon-btn" title="שבוע קודם">&#8250;</button>
              <button id="weekToday" type="button">שבוע נוכחי</button>
              <button id="weekNext" type="button" class="secondary icon-btn" title="שבוע הבא">&#8249;</button>
            </div>
          </div>

          <!-- Mode toolbar for calendar -->
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-calendar-mode="schedule" class="mode-tab active">תרשים יומי</button>
              <button data-calendar-mode="list" class="mode-tab">רשימת פגישות</button>
              <button data-calendar-mode="print" class="mode-tab">הדפסה</button>
            </div>
            <div class="mode-actions">
              <div id="hourRangeButtons" class="hour-range-filters"></div>
              <select id="staffFilter" class="search-input" style="width:160px"></select>
              <input id="bookingSearch" class="search-input" placeholder="חיפוש לפי שם מטופל, מטפל או חדר..." />
            </div>
          </div>

          <!-- Stats row -->
          <div id="dashboardStats" class="stats-row"></div>

          <!-- Day tabs -->
          <div id="dayTabs" class="day-tabs"></div>

          <!-- Active day heading -->
          <p id="dayHeading" class="day-heading"></p>

          <!-- Tag filters -->
          <details class="filter-collapsible" open>
            <summary>סינון לפי תגית</summary>
            <div id="tagFilters" class="chips"></div>
          </details>

          <!-- Schedule view -->
          <div id="scheduleView">
            <div class="table-scroll">
              <table id="occupancyTable" class="occ-table"></table>
            </div>
          </div>

          <!-- List view -->
          <div id="listView" class="hidden">
            <div id="bookingListView" class="booking-list"></div>
          </div>

          <!-- Print view -->
          <div id="printView" class="hidden">
            <div id="printSchedule" class="print-schedule"></div>
          </div>
        </section>

        <!-- ======== REQUESTS TAB ======== -->
        <section id="requestsTab" class="card tab-content hidden">
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-mode="view" class="mode-tab active">צפייה</button>
              <button data-mode="export" class="mode-tab">ייצוא</button>
            </div>
          </div>
          <div id="requestsViewMode">
            <div class="section-head">
              <h2>בקשות שינוי</h2>
              <p class="muted">שלחו בקשה לשינוי הזמנה – תועבר לאישור מנהל.</p>
            </div>
            <form id="requestForm" class="grid-form">
              <input type="hidden" id="requestTargetEntry" />
              <label>צוות <select id="requestTeam" required></select></label>
              <label>חדר <select id="requestRoom" required></select></label>
              <label>יום <select id="requestDay" required></select></label>
              <label>שעת התחלה <select id="requestStart" required></select></label>
              <label>שעת סיום <select id="requestEnd" required></select></label>
              <label>איש/ת צוות <input id="requestStaff" list="requestStaffList" autocomplete="off" required /></label>
              <datalist id="requestStaffList"></datalist>
              <label class="full">סיבת בקשה <textarea id="requestReason" required></textarea></label>
              <label class="checkbox-label"><input id="requestOneTime" type="checkbox" checked /><span>שינוי חד-פעמי</span></label>
              <button type="submit">שלח בקשה</button>
            </form>
            <h3>בקשות ממתינות</h3>
            <div id="requestsList"></div>
          </div>
          <div id="requestsExportMode" class="hidden">
            <div class="section-head"><h2>ייצוא בקשות</h2></div>
            <button id="exportRequestsBtn" class="secondary">הורד CSV</button>
          </div>
        </section>

        <!-- ======== STAFF TAB ======== -->
        <section id="staffTab" class="card tab-content hidden admin-only">
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-mode="view" class="mode-tab active">צפייה</button>
              <button data-mode="edit" class="mode-tab">עריכה</button>
              <button data-mode="export" class="mode-tab">ייצוא</button>
            </div>
          </div>
          <div id="staffViewMode">
            <!-- Profile cards rendered by JS -->
          </div>
          <div id="staffEditMode" class="hidden">
            <div class="admin-two-col">
              <article class="panel">
                <h3 class="panel-title">משתמשים</h3>
                <form id="adminUserForm" class="grid-form compact-form">
                  <input type="hidden" id="adminUserId" />
                  <label>שם משתמש <input id="adminUserName" required /></label>
                  <label>תפקיד <select id="adminUserRole"><option value="staff">צוות</option><option value="admin">מנהל</option></select></label>
                  <label>שיוך <select id="adminUserStaff"><option value="">ללא</option></select></label>
                  <div class="form-actions">
                    <button id="adminUserSaveBtn" type="submit">צור משתמש</button>
                    <button id="adminUserClearBtn" type="button" class="secondary hidden">ניקוי</button>
                  </div>
                </form>
                <div id="adminUserNewPwd" class="hidden"></div>
                <h4>בקשות איפוס</h4>
                <div id="adminResetRequests"></div>
                <h4>משתמשים</h4>
                <div id="adminUserList" class="admin-list"></div>
              </article>
              <article class="panel">
                <h3 class="panel-title">צוות</h3>
                <div class="template-links">
                  <a href="templates/staff_template.csv" download>תבנית CSV</a>
                  <button id="exportStaffBtn" class="btn-link">הורד CSV נוכחי</button>
                  <label class="file-upload-label">יבוא <input type="file" id="staffUpload" accept=".csv,.json" /></label>
                </div>
                <form id="adminStaffForm" class="grid-form compact-form">
                  <input type="hidden" id="adminStaffId" />
                  <label>שם מלא <input id="adminStaffName" required /></label>
                  <label>טלפון <input id="adminStaffPhone" type="tel" /></label>
                  <label>דוא"ל <input id="adminStaffEmail" type="email" /></label>
                  <label>תפקיד <input id="adminStaffRole" /></label>
                  <label>צוות <select id="adminStaffTeam"></select></label>
                  <div class="form-actions">
                    <button id="adminStaffSaveBtn" type="submit">הוסף</button>
                    <button id="adminStaffClearBtn" type="button" class="secondary hidden">ניקוי</button>
                  </div>
                </form>
                <div id="adminStaffList" class="admin-list"></div>
              </article>
            </div>
          </div>
          <div id="staffExportMode" class="hidden">
            <div class="section-head"><h2>ייצוא צוות</h2></div>
            <button id="exportStaffCSVBtn" class="secondary">הורד CSV</button>
          </div>
        </section>

        <!-- ======== MEETINGS TAB ======== -->
        <section id="meetingsTab" class="card tab-content hidden">
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-mode="view" class="mode-tab active">צפייה</button>
              <button data-mode="edit" class="mode-tab">עריכה</button>
              <button data-mode="export" class="mode-tab">ייצוא</button>
            </div>
          </div>
          <div id="meetingsViewMode">
            <div class="section-head"><h2>ישיבות צוות</h2></div>
            <div id="meetingList"></div>
          </div>
          <div id="meetingsEditMode" class="hidden">
            <div class="admin-two-col">
              <article class="panel">
                <h3>קבוצות</h3>
                <form id="groupForm" class="grid-form compact-form">
                  <input type="hidden" id="groupId" />
                  <label>שם <input id="groupName" required /></label>
                  <label>צבע <input id="groupColor" type="color" /></label>
                  <label>יום שבועי <select id="groupDay"></select></label>
                  <label>שעה <input id="groupTime" type="time" /></label>
                  <button type="submit">שמור קבוצה</button>
                </form>
                <div id="groupList"></div>
              </article>
              <article class="panel">
                <h3>ישיבות</h3>
                <form id="meetingForm" class="grid-form compact-form">
                  <label>כותרת <input id="meetingTitle" /></label>
                  <label>דובר <input id="meetingSpeaker" /></label>
                  <label>קבוצות <select id="meetingGroupIds" multiple></select></label>
                  <label>תאריך <input id="meetingDate" type="date" /></label>
                  <label>שעה <input id="meetingTime" type="time" /></label>
                  <label>משך (דקות) <input id="meetingDuration" type="number" min="30" value="60" /></label>
                  <label>חזרה <select id="meetingRecurring"><option value="">חד-פעמית</option><option value="weekly">שבועית</option><option value="biweekly">דו-שבועית</option><option value="monthly-first">חודשית ראשונה</option></select></label>
                  <label class="full">סדר יום <textarea id="meetingAgenda"></textarea></label>
                  <label class="full">קישור <input id="meetingLink" type="url" /></label>
                  <label>קבצים <input id="meetingFiles" type="file" multiple /></label>
                  <button type="submit">שמור ישיבה</button>
                </form>
              </article>
            </div>
          </div>
          <div id="meetingsExportMode" class="hidden">
            <div class="section-head"><h2>ייצוא ישיבות</h2></div>
            <button id="exportMeetingsCSVBtn" class="secondary">הורד CSV</button>
          </div>
        </section>

        <!-- ======== RESOURCES TAB ======== -->
        <section id="resourcesTab" class="card tab-content hidden">
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-mode="browse" class="mode-tab active">עיון</button>
              <button data-mode="upload" class="mode-tab">העלאה</button>
              <button data-mode="download" class="mode-tab">הורדות</button>
            </div>
          </div>
          <div id="resourcesBrowseMode">
            <div id="resourceList"></div>
          </div>
          <div id="resourcesUploadMode" class="hidden">
            <div class="section-head"><h2>העלאת קבצים</h2></div>
            <div class="upload-area">
              <p>גררו קבצים לכאן או לחצו לבחירה</p>
              <input type="file" id="resourceFileUpload" multiple />
            </div>
            <div id="uploadProgress"></div>
          </div>
          <div id="resourcesDownloadMode" class="hidden">
            <div class="section-head"><h2>הורדות</h2></div>
            <div id="downloadableFilesList"></div>
          </div>
        </section>

        <!-- ======== ISSUES TAB ======== -->
        <section id="issuesTab" class="card tab-content hidden">
          <div class="mode-toolbar">
            <div class="mode-tabs">
              <button data-mode="board" class="mode-tab active">לוח</button>
              <button data-mode="report" class="mode-tab">דיווח</button>
              <button data-mode="summary" class="mode-tab">סיכום</button>
            </div>
          </div>
          <div id="issuesBoardMode">
            <div id="issueQueue"></div>
          </div>
          <div id="issuesReportMode" class="hidden">
            <div class="section-head"><h2>דיווח תקלה</h2></div>
            <form id="issueForm" class="grid-form">
              <label>חדר <select id="issueRoom"><option value="">כללי</option></select></label>
              <label>סוג <select id="issueType"></select></label>
              <label>דחיפות <select id="issuePriority"></select></label>
              <label class="full">תיאור <textarea id="issueText" required></textarea></label>
              <button type="submit">שלח</button>
            </form>
          </div>
          <div id="issuesSummaryMode" class="hidden">
            <div id="issuesSummary"></div>
          </div>
        </section>

        <!-- ======== ADMIN TAB ======== -->
        <section id="adminTab" class="card tab-content hidden admin-only">
          <div class="admin-two-col">
            <article class="panel">
              <h3 class="panel-title">חדרים</h3>
              <div class="template-links">
                <a href="templates/rooms_template.csv" download>תבנית CSV</a>
                <button id="exportRoomsBtn" class="btn-link">הורד CSV</button>
                <label class="file-upload-label">יבוא <input type="file" id="roomUpload" accept=".csv,.json" /></label>
              </div>
              <form id="adminRoomForm" class="grid-form compact-form">
                <input type="hidden" id="adminRoomId" />
                <label>שם <input id="adminRoomName" required /></label>
                <label class="full">תגיות <input id="adminRoomTags" /></label>
                <div class="form-actions">
                  <button id="adminRoomSaveBtn" type="submit">הוסף</button>
                  <button id="adminRoomClearBtn" type="button" class="secondary hidden">ניקוי</button>
                </div>
              </form>
              <div id="adminRoomList" class="admin-list"></div>
            </article>
            <article class="panel">
              <h3 class="panel-title">מסך תצוגה</h3>
              <form id="displaySettingsForm" class="grid-form compact-form">
                <label>החלפה בשניות <input id="displaySwitchSeconds" type="number" min="5" /></label>
                <label>אחורה בשעות <input id="displayHoursBefore" type="number" min="0" /></label>
                <label>קדימה בשעות <input id="displayHoursAfter" type="number" min="1" /></label>
                <label>חדרים בעמוד <input id="displayRoomsPerPage" type="number" min="1" /></label>
                <button type="submit">שמור</button>
              </form>
              <form id="displayMessageForm" class="grid-form compact-form">
                <label>הודעה <textarea id="displayMessageText" rows="2"></textarea></label>
                <label>משך <select id="displayMessageDuration"><option value="5">5 דקות</option><option value="10">10</option><option value="30">30</option><option value="60">60</option><option value="unlimited">ללא הגבלה</option></select></label>
                <button type="submit">הוסף</button>
              </form>
              <div id="displayMessagesList"></div>
            </article>
          </div>
          <article class="panel">
            <h3>בקרה וגיבויים</h3>
            <div class="template-links">
              <button id="exportBackupBtn" class="secondary">ייצוא גיבוי (JSON)</button>
              <label class="file-upload-label">שחזור <input type="file" id="backupUpload" accept=".json" /></label>
              <button id="clearAuditBtn" class="secondary">נקה יומן</button>
            </div>
            <div id="adminAuditList" class="admin-list"></div>
          </article>
        </section>

      </main>
    </div><!-- /app-layout -->
  </section><!-- /appSection -->

  <script type="module" src="src/main.js"></script>
</body>
</html>
