{$DOMAIN} {
  tls {$TLS_EMAIL}
  reverse_proxy app:8000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

haatzmaut.lior-clinic.org {
  tls {$TLS_EMAIL}
  root * /srv/haatzmaut
  file_server

  @api path /api/*
  handle @api {
    reverse_proxy haatzmaut_sync:3001
    header {
      Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
      Pragma "no-cache"
      Expires "0"
    }
  }

  @html path / /index.html /display.html /accessibility.html /export-helper.html
  header @html Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

  @assets path_regexp assets \\.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$
  header @assets Cache-Control "public, max-age=31536000, immutable"

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
